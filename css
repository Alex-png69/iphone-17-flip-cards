* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}


body {

  min-height: 100vh;

  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "SF Pro Display",
    "Segoe UI",
    sans-serif;

  background: #f5f5f7;

  color: #111;

}


.page {

  max-width: 1450px;

  margin: auto;

  padding:
    70px 35px
    50px;

}


/* =========================
   HERO
========================= */

.hero {

  text-align: center;

  max-width: 700px;

  margin:
    0 auto 65px;

}


.apple-logo {

  width: 42px;
  height: 42px;

  margin:
    0 auto 25px;

  border-radius: 50%;

  display: flex;

  justify-content: center;

  align-items: center;

  background: #000;

  color: #fff;

  font-size: 20px;

}


.eyebrow {

  font-size: 10px;

  font-weight: 700;

  letter-spacing: 3px;

  color: #888;

  margin-bottom: 18px;

}


.hero h1 {

  font-size:
    clamp(45px, 6vw, 75px);

  line-height: 1;

  letter-spacing: -4px;

}


.hero h1 span {

  color: #777;

}


.subtitle {

  margin-top: 20px;

  color: #888;

  font-size: 16px;

  line-height: 1.6;

}


/* =========================
   GRID
========================= */

.products {

  max-width: 1250px;

  margin: auto;

  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  gap: 22px;

}


/* =========================
   FLIP CARD
========================= */

.flip-card {

  height: 560px;

  perspective: 1400px;

  cursor: pointer;

}


.flip-card-inner {

  position: relative;

  width: 100%;
  height: 100%;

  transform-style:
    preserve-3d;

  transition:
    transform
    .8s
    cubic-bezier(
      .2,
      .7,
      .2,
      1
    );

}


/* CLICK FLIP */

.flip-card.flipped
.flip-card-inner {

  transform:
    rotateY(180deg);

}


/* =========================
   SIDES
========================= */

.flip-card-front,
.flip-card-back {

  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  border-radius: 28px;

  overflow: hidden;

  backface-visibility:
    hidden;

  -webkit-backface-visibility:
    hidden;

}


/* =========================
   FRONT
========================= */

.flip-card-front {

  background: white;

  border:
    1px solid
    rgba(0,0,0,.07);

  box-shadow:
    0 20px 60px
    rgba(0,0,0,.08);

}


.number {

  position: absolute;

  top: 18px;
  right: 22px;

  z-index: 5;

  font-size: 11px;

  font-weight: 700;

  color:
    rgba(0,0,0,.45);

}


/* =========================
   PRODUCT IMAGE
========================= */

.product-visual {

  width: 100%;

  height: 370px;

  display: flex;

  align-items: center;

  justify-content: center;

  overflow: hidden;

  background: #f7f7f7;

}


.product-visual img {

  width: 100%;

  height: 100%;

  object-fit: cover;

  display: block;

  transition:
    transform .6s ease;

}


.flip-card:hover
.product-visual img {

  transform:
    scale(1.035);

}


/* AIR */

.product-visual.air {

  background: #f5f5f5;

}


.product-visual.air img {

  object-fit: cover;

}


/* =========================
   FRONT TEXT
========================= */

.front-content {

  padding:
    23px 26px;

}


.label {

  font-size: 9px;

  font-weight: 700;

  letter-spacing: 2px;

  color: #888;

}


.front-content h2 {

  margin-top: 8px;

  font-size: 27px;

  letter-spacing: -1px;

}


.front-content p {

  margin-top: 7px;

  color: #999;

  font-size: 13px;

}


.hint {

  margin-top: 22px;

  font-size: 9px;

  font-weight: 700;

  letter-spacing: 1.5px;

  color: #555;

}


.hint span {

  margin-left: 5px;

  transition:
    transform .25s;

}


.flip-card:hover
.hint span {

  display: inline-block;

  transform:
    translate(
      3px,
      -3px
    );

}


/* =========================
   BACK
========================= */

.flip-card-back {

  transform:
    rotateY(180deg);

  padding: 35px;

  display: flex;

  flex-direction: column;

  justify-content: center;

}


.blue {

  background:
    linear-gradient(
      145deg,
      #eef6ff,
      #d9eaff
    );

}


.titanium {

  background:
    linear-gradient(
      145deg,
      #eeeeef,
      #c5c5c9
    );

}


.dark {

  background:
    linear-gradient(
      145deg,
      #242424,
      #080808
    );

  color: white;

}


.silver {

  background:
    linear-gradient(
      145deg,
      #fafafa,
      #dedede
    );

}


/* =========================
   BACK CONTENT
========================= */

.back-top {

  display: flex;

  justify-content:
    space-between;

  font-size: 8px;

  font-weight: 700;

  letter-spacing: 2px;

  opacity: .5;

}


.flip-card-back h2 {

  margin-top: 35px;

  font-size: 30px;

  letter-spacing: -1px;

}


.description {

  margin-top: 15px;

  font-size: 13px;

  line-height: 1.7;

  opacity: .6;

}


/* =========================
   SPECS
========================= */

.specs {

  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 7px;

  margin-top: 28px;

}


.spec {

  padding:
    14px 5px;

  border-radius: 14px;

  text-align: center;

  background:
    rgba(255,255,255,.5);

}


.dark .spec {

  background:
    rgba(255,255,255,.1);

}


.spec strong {

  display: block;

  font-size: 12px;

}


.spec small {

  display: block;

  margin-top: 5px;

  font-size: 7px;

  opacity: .55;

}


/* =========================
   PRICE
========================= */

.purchase {

  margin-top: auto;

  display: flex;

  align-items: center;

  justify-content:
    space-between;

}


.purchase strong {

  font-size: 20px;

}


.purchase button {

  border: none;

  border-radius: 50px;

  padding:
    12px 18px;

  background: #000;

  color: white;

  font-size: 9px;

  font-weight: 700;

  letter-spacing: 1px;

  cursor: pointer;

}


.dark .purchase button {

  background: white;

  color: #000;

}


/* =========================
   FOOTER
========================= */

footer {

  text-align: center;

  margin-top: 60px;

  color: #aaa;

  font-size: 9px;

  letter-spacing: 2px;

}


/* =========================
   RESPONSIVE
========================= */

@media (max-width: 1100px) {

  .products {

    grid-template-columns:
      repeat(2, 1fr);

    max-width: 800px;

  }

}


@media (max-width: 600px) {

  .page {

    padding:
      45px 18px;

  }

  .products {

    grid-template-columns: 1fr;

    max-width: 390px;

  }

  .hero h1 {

    font-size: 42px;

  }

}
